<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production / Release: strictly HTTPS only, trusting system CAs only (OWASP MASVS-NETWORK) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
