APP_NAME="Universal Identity Service"
APP_ENV=local
APP_KEY=base64:eZgVvUuQ2i9F1f6P7e8R9S0T1U2V3W4X5Y6Z7A8B9C0=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://127.0.0.1:8001
SERVER_PORT=8001

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kreavana_iam
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=iam_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@identity.kreavana.com"
MAIL_FROM_NAME="${APP_NAME}"

# CORS (comma-separated exact origins in production; leave empty if S2S-only behind backend BFF)
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_PATTERNS=

# JWT & SSO Configuration
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARS
JWT_TTL=60
JWT_REFRESH_TTL=43200
JWT_ALGO=HS256

# Multi-Application OAuth2 / S2S HMAC Credentials (MUST match backend USERS_API_CLIENT_SECRET)
DEFAULT_CLIENT_ID=kreavana_app
USERS_API_CLIENT_SECRET=CHANGE_ME_GENERATE_64_HEX_SECRET
