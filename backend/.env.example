APP_NAME=Kreavana
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Comma-separated exact origins for credentialed CORS in non-local environments.
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
# Comma-separated regex patterns for allowed origins in non-local environments.
CORS_ALLOWED_ORIGIN_PATTERNS=

JWT_SECRET=
JWT_TTL=10
JWT_ALGO=HS256
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
JWT_PASSPHRASE=
JWT_ISSUER="${APP_URL}"
JWT_AUDIENCE="${APP_URL}"
AUTH_REFRESH_COOKIE=refresh_token
AUTH_REFRESH_TTL=43200
API_NORMAL_ROUTE_BUDGET_MS=250
API_LIGHTWEIGHT_RESPONSE_BUDGET_BYTES=300

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Default: SQLite, atau sesuaikan jika menggunakan MySQL)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kreavana
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Cache: Gunakan 'file' untuk development lokal tanpa Redis, atau 'redis' jika Redis aktif
CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@kreavana.local"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Reverb (WebSocket Server)
REVERB_APP_ID=kreavana_app
REVERB_APP_KEY=cuzkfya73cpnszss3vc2
REVERB_APP_SECRET=kreavana_secret
REVERB_HOST="0.0.0.0"
REVERB_PORT=8080
REVERB_SCHEME=http

# Pusher compatible broadcasting
PUSHER_APP_ID="${REVERB_APP_ID}"
PUSHER_APP_KEY="${REVERB_APP_KEY}"
PUSHER_APP_SECRET="${REVERB_APP_SECRET}"
PUSHER_HOST="${REVERB_HOST}"
PUSHER_PORT="${REVERB_PORT}"
PUSHER_SCHEME="${REVERB_SCHEME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FIREBASE_CREDENTIALS=your_path_credential

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=